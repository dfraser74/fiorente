y\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#282124\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container-fluid\">\n        <div class=\"row\">\n            <div class=\"col-lg-6 col-md-12 col align-left\">\n                <div class=\"row h-100\">\n                    <div class=\"wrap\">\n                        <div class=\"overlay\"></div>\n                        <div class=\"img-content\"></div>\n                        <div class=\"box-content\">\n                            <div class=\"content-box\">\n                                <h4 class=\"box-title2 mbr-medium pb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".box-title2\">Superannuation is not just an investment. It's a tax-effective strategy.</h4>\n                                <h3 class=\"box-text2 mbr-regular pb-2 mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".box-text2\">A powerful tool to accumulate wealth.</h3>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-lg-6 col-md-12 block2 align-left\">\n                <div class=\"content-block\">\n                    <h3 class=\"mbr-section-subtitle mbr-regular mbr-black pb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubTitle\"><b>Superannuation</b>&nbsp;&amp; SMSF</h3>\n                    <h2 class=\"mbr-section-title mbr-semibold mbr-black pb-